# Environment & secrets (NEVER commit credentials or local env configs)
.env
.env.*
*.env
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
secrets.*
credentials.*

# Sales data files, uploads, exports & local databases (NEVER commit real business data)
data/
uploads/
exports/
storage/
tmp/
temp/
*.db
*.sqlite
*.sqlite3
*.duckdb
*.dump
*.bak
*.sql.gz
*.parquet
*.feather
*.arrow
*.xlsx
*.xls
*.xlsm
*.xlsb
*.ods
*.csv
*.tsv
*.zip
*.rar
*.7z
*.tar.gz
# Only allow small anonymized test fixtures under tests/fixtures/
!**/tests/fixtures/*.csv
!**/tests/fixtures/*.json

# Node / Frontend
node_modules/
dist/
build/
.next/
.vite/
.turbo/
.eslintcache
coverage/
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python / Backend
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# OS & Editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.log
