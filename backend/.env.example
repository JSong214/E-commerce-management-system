# SJH-DATA 后端环境变量示例模板（可安全提交到 Git）
# 使用方式：复制为 backend/.env 后填入本地实际密码；.env 已被 .gitignore 忽略，不会提交到仓库。

# --- MySQL 数据库配置（同时供 Docker Compose 与后端自动读取）---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=sjh_data
MYSQL_USER=sjh
# 请在本地 backend/.env 中填入密码（若密码含特殊字符如 @ # : / ?，建议用单引号包裹）
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# 可选：直接指定完整 SQLAlchemy 连接串（非空时优先于上方 MYSQL_* 组合）
# DATABASE_URL=mysql+pymysql://sjh:your_password@127.0.0.1:3307/sjh_data?charset=utf8mb4

# --- 服务与存储配置 ---
# 允许跨域访问的前端地址，多个地址用英文逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 可选：自定义导入暂存目录（留空则使用默认 backend/storage/staging）
# STAGING_DIR=

# --- 集成测试数据库（可选，仅在运行 MySQL 集成测试时配置，务必使用独立测试实例）---
# TEST_MYSQL_HOST=127.0.0.1
# TEST_MYSQL_PORT=3308
# TEST_MYSQL_USER=root
# TEST_MYSQL_PASSWORD=
# 或直接指定：
# TEST_DATABASE_URL=mysql+pymysql://root:your_test_password@127.0.0.1:3308/?charset=utf8mb4
